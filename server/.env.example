# ── Server ──────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (Postgres/Neon) ────────
DATABASE_URL=

# ── Auth ────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── CORS / FE ───────────────────────
CLIENT_URL=

# ── Email OTP (SMTP) ────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# SMTP_PASS = App Password của Gmail; KHÔNG commit file .env thật.

# ── (mở khi cần) Upload ────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
