# ── Server ──────────────────────────
# PORT: chỉ dùng khi chạy local. Trên Render, nền tảng tự inject PORT — KHÔNG khai báo lại.
PORT=5000
NODE_ENV=development

# ── Database (Postgres/Neon) ────────
DATABASE_URL=

# ── Auth ────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── CORS / FE ───────────────────────
CLIENT_URL=

# ── Cloudinary avatar uploads ───────
CLOUDINARY_AVATAR_CLOUD_NAME=
CLOUDINARY_AVATAR_API_KEY=
CLOUDINARY_AVATAR_API_SECRET=
CLOUDINARY_AVATAR_UPLOAD_PRESET=greenbowl_avatar_signed

# ── Cloudinary ảnh bìa (bài viết, công thức, món) — Khôi ──
# Bộ riêng, KHÔNG đặt trùng tên với CLOUDINARY_* ở trên. Bỏ trống cả 3 thì dùng lại bộ CLOUDINARY_* chung.
CLOUDINARY_POST_CLOUD_NAME=
CLOUDINARY_POST_API_KEY=
CLOUDINARY_POST_API_SECRET=

# ── Email OTP (SMTP) ────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# SMTP_PASS = App Password của Gmail; KHÔNG commit file .env thật.

# ── Chatbot (DeepSeek) ──────────────
# CHATBOT_REQUEST_HMAC_KEY: chuỗi ngẫu nhiên ≥ 32 ký tự, dùng ký phiên + lịch sử chatbot.
CHATBOT_REQUEST_HMAC_KEY=
DEEPSEEK_API_KEY=
# CHATBOT_CLEANUP_ENABLED=true mới bật dọn metadata rác của luồng cũ chạy định kỳ.
CHATBOT_CLEANUP_ENABLED=

# ── Proxy ───────────────────────────
# TRUST_PROXY: số lớp proxy phía trước server; local để trống. Render tự dùng 3 (Cloudflare + cân bằng tải), Heroku để 1.
TRUST_PROXY=
